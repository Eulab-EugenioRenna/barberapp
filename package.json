{
  "name": "barber-saas",
  "version": "0.1.0",
  "private": true,
  "description": "White-label SaaS platform for bookings, services, collaborators, sales, notifications, and revenue dashboards.",
  "scripts": {
    "serve:api": "nest start --watch --config apps/api/nest-cli.json",
    "serve:admin": "ng serve web-admin --host 0.0.0.0",
    "serve:public": "ng serve web-public-booking --host 0.0.0.0 --port 4201",
    "build": "npm run build:api && npm run build:admin && npm run build:public",
    "build:api": "nest build --config apps/api/nest-cli.json",
    "build:admin": "ng build web-admin",
    "build:public": "ng build web-public-booking",
    "lint": "eslint \"{apps,libs}/**/*.ts\"",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "node scripts/prisma-bootstrap.js",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed:platform-demo": "ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' prisma/seed.ts",
    "demo:create": "ts-node --transpile-only --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' scripts/create-demo-account.ts"
  },
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/cache-manager": "^2.2.2",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/swagger": "^8.1.0",
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.12.15",
    "cache-manager": "^5.7.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^7.2.0",
    "ioredis": "^5.4.1",
    "nodemailer": "^6.10.0",
    "rxjs": "^7.8.1",
    "zone.js": "^0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.0",
    "@angular/cli": "^18.2.0",
    "@angular/compiler-cli": "^18.2.0",
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.0",
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^6.4.17",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.15.0",
    "jest": "^29.7.0",
    "nx": "^20.0.0",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "5.5.4"
  }
}
