# ALORA produzione: copiare in /srv/alora/.env.production sulla VM, chmod 600.
# Mai committare il file compilato, mai incollarlo in chat o negli issue.
# Generare i segreti sul server, es.: openssl rand -base64 48

# --- Database e cache (usati anche dal compose per l'interpolazione) ---
POSTGRES_DB=alora
POSTGRES_USER=alora
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- Ingresso: IP e porta su cui nginx ascolta (verso tunnel Cloudflare / proxy) ---
ALORA_BIND_IP=127.0.0.1
ALORA_HTTP_PORT=8080

# --- Applicazione ---
# DA CONFERMARE: dominio pubblico di ALORA (qui alora.eulab.cloud come segnaposto).
APP_ENV=production
NODE_ENV=production
LOG_LEVEL=info
PORT=3000
APP_ORIGIN=https://alora.eulab.cloud
PUBLIC_APP_URL=https://alora.eulab.cloud
ADMIN_APP_URL=https://alora.eulab.cloud
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
WEBHOOK_TIMEOUT_MS=5000
ALORA_DEPLOYMENT_NAME=alora-production
DEMO_BOOTSTRAP=false

# --- Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ALORA

# --- EULAB Connect (piattaforma connect.eulab.cloud, Keycloak auth.eulab.cloud) ---
# Valori forniti dal pannello Connect al momento della registrazione dell'app.
ALORA_CONNECT_API_URL=https://connect.eulab.cloud
# DA CONFERMARE: oggi Keycloak di Connect è compilato con prefisso /sso
# (issuer https://auth.eulab.cloud/sso/realms/eulab); senza prefisso diventa /realms/eulab.
ALORA_CONNECT_ISSUER=https://auth.eulab.cloud/sso/realms/eulab
ALORA_CONNECT_CATALOG_URL=
ALORA_CONNECT_APP_ID=
ALORA_CONNECT_CLIENT_ID=
ALORA_CONNECT_CLIENT_SECRET=
ALORA_CONNECT_CALLBACK_URL=https://alora.eulab.cloud/api/auth/connect/callback
ALORA_AUTH_RETURN_URL=https://alora.eulab.cloud/admin/
ALORA_CONNECT_ENCRYPTION_KEY=
ALORA_CONNECT_SOURCE_ID=
ALORA_CONNECT_BOOTSTRAP_SECRET=
ALORA_CONNECT_PRESENTER_ID=
ALORA_CONNECT_PRESENTER_SECRET=
ALORA_CONNECT_TENANTS_JSON=
