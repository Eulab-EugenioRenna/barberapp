DATABASE_URL="postgresql://barber:barber@postgres:5432/barber?schema=public"
JWT_ACCESS_SECRET="replace-me-access"
JWT_REFRESH_SECRET="replace-me-refresh"
APP_ENV="development"
PUBLIC_APP_URL="http://localhost:8080"
ADMIN_APP_URL="http://localhost:8080"
LOG_LEVEL="debug"
PORT=3000
REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_PASSWORD=""
SMTP_HOST="mailhog"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_EMAIL="no-reply@barber.test"
SMTP_FROM_NAME="ALORA by EULAB"
WEBHOOK_TIMEOUT_MS=5000

# Manual bootstrap only: configure PLATFORM_ADMIN_EMAIL and PLATFORM_ADMIN_PASSWORD
# in the local .env to create a new administrator. Existing accounts are preserved.
# DEMO_OWNER_PASSWORD is required for demo:create. SEED_DEMO=1 enables the demo
# tenant when seed:platform-demo is invoked explicitly. Development Compose uses
# the same complete generator by default; existing data are preserved. No passwords are logged.

# Declared application identity; it may precede application registration.
ALORA_CONNECT_APP_ID=

# Mandatory Connect access. An empty map never enables local tenant access.
# All values are server-side; no default public Connect hostname is assumed.
ALORA_CONNECT_API_URL=
# Issuer/client are optional with a presenter; acquired after admin configuration.
ALORA_CONNECT_ISSUER=
ALORA_CONNECT_CLIENT_ID=
# Optional confidential BFF client secret, server only.
ALORA_CONNECT_CLIENT_SECRET=
ALORA_CONNECT_CALLBACK_URL=
ALORA_AUTH_RETURN_URL=
ALORA_CONNECT_ENCRYPTION_KEY=
ALORA_CONNECT_TENANTS_JSON={}

# Assisted onboarding uses SDK 0.10.0; password recovery requires Connect schema 012.
# SOURCE_ID is stable per deployment and can be reserved on first presenter use.
# BOOTSTRAP_SECRET is only for an already registered legacy source.
ALORA_CONNECT_SOURCE_ID=
ALORA_CONNECT_BOOTSTRAP_SECRET=

# Local Compose ingress (Keycloak may already occupy 8080).
ALORA_HTTP_PORT=53020
APP_ORIGIN=http://127.0.0.1:53020
# Set locally before running docker compose exec api npm run demo:create.
DEMO_OWNER_PASSWORD=
DEMO_BOOTSTRAP=1

# First request uses the existing SDK presenter capability (Connect schema 013).
# SOURCE_ID identifies this deployment; it is reserved by the first SDK discovery.
# No pre-existing application/customer/license or OIDC client is required.
ALORA_CONNECT_PRESENTER_ID=
ALORA_CONNECT_PRESENTER_SECRET=
ALORA_DEPLOYMENT_NAME=ALORA sviluppo
# Optional HTTPS catalog URL when different from the public origin.
ALORA_CONNECT_CATALOG_URL=

# Optional local Connect transport; requires the private dev CA and Connect Docker.
# COMPOSE_FILE=docker-compose.yml:docker-compose.connect-local.yml
# ALORA_CONNECT_DOCKER_NETWORK=eulab-connect_edge

# Optional backend provider transport origin; canonical issuer stays unchanged.
ALORA_CONNECT_OIDC_TRANSPORT_ORIGIN=
