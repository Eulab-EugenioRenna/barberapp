generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  platform_admin
  owner
  manager
  collaborator
  reception
  client
}

enum BookingMode {
  public
  closed
  hybrid
}

enum AppointmentStatus {
  draft
  requested
  confirmed
  checked_in
  completed
  cancelled
  no_show
  rescheduled
}

enum AppointmentSource {
  public
  internal
  import
  api
}

enum PaymentStatus {
  unpaid
  paid
  partial
  refunded
  cancelled
}

enum NotificationChannel {
  email
  telegram
  whatsapp
  in_app
  webhook
}

enum NotificationStatus {
  queued
  dispatching
  uncertain
  pending
  sent
  failed
  skipped
}

enum NotificationRecipientType {
  user
  collaborator
  customer
  webhook
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  suspended
  cancelled
}

enum BillingInterval {
  monthly
  yearly
  one_time
}

model Tenant {
  whatsAppLinks WhatsAppLink[]
  whatsAppMedia WhatsAppMedia[]
  whatsAppSends WhatsAppSend[]
  whatsAppChats WhatsAppChat[]
  appointmentAutomationRuns AppointmentAutomationRun[]
  notificationAutomationWebhook NotificationAutomationWebhook?
  notificationAutomationWebhookEvents NotificationAutomationWebhookEvent[]
  notificationAutomationGrants NotificationAutomationGrant[]
  notificationAutomationCommands NotificationAutomationCommand[]
  appointmentAutomationPolicy AppointmentAutomationPolicy?
  notificationDomainEvents NotificationDomainEvent[]
  orderOperations OrderOperation[]
  paymentOperations PaymentOperation[]
  paymentEntries PaymentEntry[]
  orderPriceRevisions OrderPriceRevision[]
  catalogPriceHistory CatalogPriceHistory[]
  inventoryOperations InventoryOperation[]
  stockBalances StockBalance[]
  stockMovements StockMovement[]
  locations                     Location[]
  sectors                       Sector[]
  activities                    Activity[]
  connectBinding ConnectTenantBinding?
  id                            String                         @id @default(uuid())
  name                          String
  slug                          String                         @unique
  publicDomain                  String?                        @unique
  defaultCollaboratorId         String?
  isActive                      Boolean                        @default(true)
  isSuspended                   Boolean                        @default(false)
  suspendedAt                   DateTime?
  suspensionReason              String?
  notes                         String?
  bookingMode                   BookingMode                    @default(hybrid)
  publicTitle                   String?
  publicDescription             String?
  publicSteps                   String[]                       @default([])
  timezone                      String                         @default("Europe/Rome")
  currency                      String                         @default("EUR")
  language                      String                         @default("it")
  primaryColor                  String                         @default("#0f766e")
  accentColor                   String                         @default("#f59e0b")
  logoUrl                       String?
  coverUrl                      String?
  publicEnabled                 Boolean                        @default(true)
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  users                         User[]
  collaborators                 Collaborator[]
  customers                     Customer[]
  services                      Service[]
  rooms                         Room[]
  appointments                  Appointment[]
  products                      Product[]
  sales                         Sale[]
  auditLogs                     AuditLog[]
  notifications                 NotificationHistory[]
  notificationInboxItems        NotificationInbox[]
  notificationPreferenceTenants NotificationPreferenceTenant[]
  notificationPreferenceUsers   NotificationPreferenceUser[]
  notificationTemplates         NotificationTemplate[]
  notificationProviderConfigs   NotificationProviderConfig[]
  subscriptions                 TenantSubscription[]
  holidays                      TenantHoliday[]
  teamAccountIntents            TeamAccountIntent[]

  @@index([createdAt])
  @@index([isActive, isSuspended])
  productBrands ProductBrand[]
  whatsappBroadcasts WhatsAppBroadcast[]
}

model TenantHoliday {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  date      DateTime
  name      String
  createdAt DateTime @default(now())

  @@unique([tenantId, date])
  @@index([tenantId, date])
}

model User {
  whatsAppLinks WhatsAppLink[]
  orderOperations OrderOperation[]
  paymentOperations PaymentOperation[]
  sectorAccess                UserSectorAccess[]
  id                          String                       @id @default(uuid())
  tenantId                    String?
  tenant                      Tenant?                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email                       String                       @unique
  passwordHash                String
  firstName                   String
  lastName                    String
  role                        UserRole
  permissions                 String[]                     @default([])
  permissionsConfigured       Boolean                      @default(false)
  isActive                    Boolean                      @default(true)
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  connectSubject              String?
  connectInstallationId       String?
  connectAcceptedAt           DateTime?
  connectActivatedAt          DateTime?
  connectSessions             ConnectSession[]
  connectAuthFlows            ConnectAuthFlow[]
  connectTechnicalAccesses    ConnectTechnicalAccess[]
  migrationChallenges         ConnectMigrationChallenge[]
  sessions                    LocalSession[]
  accountIntent               TeamAccountIntent?
  collaborator                Collaborator?
  notificationInboxItems      NotificationInbox[]
  notificationPreferenceUsers NotificationPreferenceUser[]

  @@index([tenantId, role])
  @@unique([connectInstallationId, connectSubject])
}

// Local creation receipt only. Passwords and provider state remain in Connect.
model TeamAccountIntent {
  userId          String    @id
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceId        String
  appId           String
  customerId      String
  installationId  String
  roleIds         String[]
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
  ssoSetupRequired Boolean?

  @@index([tenantId, completedAt])
}

model Collaborator {
  sectors         CollaboratorSector[]
  id              String                       @id @default(uuid())
  tenantId        String
  tenant          Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId          String?                      @unique
  user            User?                        @relation(fields: [userId], references: [id], onDelete: SetNull)
  firstName       String
  lastName        String
  email           String?
  phone           String?
  calendarColor   String                       @default("#0f766e")
  isPublic        Boolean                      @default(false)
  isActive        Boolean                      @default(true)
  appointments    Appointment[]
  saleItems       SaleItem[]
  sales           Sale[]
  weeklySchedules CollaboratorWeeklySchedule[]
  dayOverrides    CollaboratorDayOverride[]

  @@index([tenantId, isActive])
}

model CollaboratorWeeklySchedule {
  id             String       @id @default(uuid())
  collaboratorId String
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  weekday        Int
  isWorkingDay   Boolean      @default(true)
  startTime      String?
  endTime        String?

  @@unique([collaboratorId, weekday])
}

model CollaboratorDayOverride {
  id             String       @id @default(uuid())
  collaboratorId String
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  date           DateTime
  isWorkingDay   Boolean      @default(true)
  startTime      String?
  endTime        String?
  note           String?
  isHoliday      Boolean      @default(false)

  @@unique([collaboratorId, date])
}

model Customer {
  appointmentAutomationRuns AppointmentAutomationRun[]
  id                   String        @id @default(uuid())
  tenantId             String
  tenant               Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  firstName            String
  lastName             String
  email                String?
  phone                String?
  birthDate            DateTime?
  tags                 String[]      @default([])
  autoTags             String[]      @default([])
  loyaltyTier          String?
  visitsCount          Int           @default(0)
  completedVisitsCount Int           @default(0)
  totalSpent           Decimal       @default(0) @db.Decimal(10, 2)
  lastAlignedAt        DateTime?
  notes                String?
  privacyConsent       Boolean       @default(false)
  marketingConsent     Boolean       @default(false)
  isActive             Boolean       @default(true)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  appointments         Appointment[]
  sales                Sale[]

  @@index([tenantId, email])
  @@index([tenantId, createdAt])
}

model Service {
  priceMode String @default("legacy")
  priceHistory CatalogPriceHistory[]
  // Home sector (first location of the activity); bookings resolve the sector of their location.
  sectorId             String           @default(dbgenerated())
  sector               Sector           @relation(fields: [sectorId, tenantId], references: [id, tenantId], onDelete: Restrict)
  activityId           String           @default(dbgenerated())
  activity             Activity         @relation(fields: [activityId, tenantId], references: [id, tenantId], onDelete: Restrict)
  id                   String           @id @default(uuid())
  tenantId             String
  tenant               Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                 String
  publicDescription    String?
  internalDescription  String?
  durationMinutes      Int
  bufferBeforeMinutes  Int              @default(0)
  bufferAfterMinutes   Int              @default(0)
  basePrice            Decimal          @db.Decimal(10, 2)
  vatRate              Decimal?         @db.Decimal(5, 2)
  category             String?
  requiresCollaborator Boolean          @default(true)
  requiresRoom         Boolean          @default(false)
  isPublic             Boolean          @default(false)
  isBookableOnline     Boolean          @default(false)
  color                String           @default("#0f766e")
  isActive             Boolean          @default(true)
  /// Position in the till grid (shared with products); ties fall back to the name.
  sortOrder            Int              @default(0)
  appointments         Appointment[]
  serviceProducts      ServiceProduct[]
  saleItems            SaleItem[]

  @@index([tenantId, isActive])
  @@index([tenantId, isBookableOnline])
  @@index([tenantId, sectorId], map: "Service_tenant_sector_idx")
  @@index([tenantId, activityId])
}

model Room {
  sectorId     String        @default(dbgenerated())
  sector       Sector        @relation(fields: [sectorId, tenantId], references: [id, tenantId], onDelete: Restrict)
  id           String        @id @default(uuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  capacity     Int           @default(1)
  notes        String?
  isPublic     Boolean       @default(false)
  isActive     Boolean       @default(true)
  appointments Appointment[]

  @@index([tenantId, isActive])
  @@index([tenantId, sectorId], map: "Room_tenant_sector_idx")
}

model Appointment {
  orderItemId    String? @unique
  orderItem      SaleItem? @relation("BookedOrderItem", fields: [orderItemId], references: [id], onDelete: Restrict)
  orderIssue     String?
  locationId     String                    @default(dbgenerated())
  location       Location                  @relation(fields: [locationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  sectorId       String                    @default(dbgenerated())
  sector         Sector                    @relation(fields: [sectorId, tenantId, locationId], references: [id, tenantId, locationId], onDelete: Restrict)
  id             String                    @id @default(uuid())
  tenantId       String
  tenant         Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer                  @relation(fields: [customerId], references: [id])
  serviceId      String
  service        Service                   @relation(fields: [serviceId], references: [id])
  collaboratorId String?
  collaborator   Collaborator?             @relation(fields: [collaboratorId], references: [id], onDelete: SetNull)
  roomId         String?
  room           Room?                     @relation(fields: [roomId], references: [id], onDelete: SetNull)
  startsAt       DateTime
  endsAt         DateTime
  status         AppointmentStatus         @default(draft)
  source         AppointmentSource         @default(internal)
  estimatedPrice Decimal?                  @db.Decimal(10, 2)
  finalPrice     Decimal?                  @db.Decimal(10, 2)
  customerNotes  String?
  internalNotes  String?
  createdById    String?
  updatedById    String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  sales          Sale[]
  cancellations  AppointmentCancellation[]

  @@index([tenantId, startsAt])
  @@index([tenantId, status])
  @@index([tenantId, collaboratorId, startsAt])
  @@index([tenantId, customerId])
  @@index([tenantId, serviceId])
  @@index([tenantId, locationId, sectorId, startsAt], map: "Appointment_tenant_scope_time_idx")
}

model Product {
  /// Position in the till grid (shared with services); ties fall back to the name.
  sortOrder Int @default(0)
  purchaseVatRate Decimal? @db.Decimal(5,2)
  costMode String @default("legacy")
  priceMode String @default("legacy")
  stockTracked Boolean @default(false)
  priceHistory CatalogPriceHistory[]
  stockBalances StockBalance[]
  stockMovements StockMovement[]
  id              String           @id @default(uuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  imageUrl        String?
  sku             String?
  barcode         String?
  category        String?
  price           Decimal?         @db.Decimal(10, 2)
  vatRate         Decimal?         @db.Decimal(5, 2)
  cost            Decimal?         @db.Decimal(10, 2)
  attributes      Json?
  isActive        Boolean          @default(true)
  serviceProducts ServiceProduct[]
  saleItems       SaleItem[]
  // Default «Rivendita» when omitted (set by the database).
  activityId      String           @default(dbgenerated())
  activity        Activity         @relation(fields: [activityId, tenantId], references: [id, tenantId], onDelete: Restrict)
  /// Optional brand: groups products in the catalogue and in Panoramica.
  brandId         String?
  brand           ProductBrand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)

  @@index([tenantId, isActive])
  @@index([tenantId, activityId])
  @@index([tenantId, brandId])
  @@index([tenantId, sku])
  @@unique([tenantId, barcode], map: "Product_tenantId_barcode_key")
}

model ProductBrand {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime  @default(now())
  products  Product[]

  @@unique([tenantId, name])
}

model ServiceProduct {
  consumptionUnits Decimal? @db.Decimal(14,3)
  id          String  @id @default(uuid())
  serviceId   String
  service     Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  mode        String
  quantity    Int     @default(1)
  priceLocked Boolean @default(false)

  @@unique([serviceId, productId])
}

model Sale {
  automationContact Json?
  appointmentAutomationRuns AppointmentAutomationRun[]
  orderOperations OrderOperation[]
  paymentBasis String @default("ledger")
  paymentOperations PaymentOperation[]
  paymentEntries PaymentEntry[]
  orderDiscount Decimal @default(0) @db.Decimal(10,2)
  orderStatus    String @default("confirmed")
  orderOrigin    String @default("legacy_sale")
  revision       Int @default(0)
  locationId     String        @default(dbgenerated())
  location       Location      @relation(fields: [locationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  id             String        @id @default(uuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  collaboratorId String?
  collaborator   Collaborator?     @relation(fields: [collaboratorId], references: [id], onDelete: SetNull)
  appointmentId  String?
  appointment    Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  subtotal       Decimal       @db.Decimal(10, 2)
  discountTotal  Decimal       @default(0) @db.Decimal(10, 2)
  taxTotal       Decimal       @default(0) @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)
  paymentStatus  PaymentStatus @default(unpaid)
  paymentMethod  String?
  soldAt         DateTime      @default(now())
  createdById    String?
  items          SaleItem[]

  @@index([tenantId, soldAt])
  @@index([tenantId, paymentStatus])
  @@index([appointmentId])
  @@index([tenantId, locationId, soldAt], map: "Sale_tenant_location_time_idx")
}

// Append-only operational declarations. These records do not charge a provider.
model PaymentOperation {
  id String @id @default(uuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  saleId String
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Restrict)
  actorUserId String
  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  idempotencyKey String
  fingerprint String
  kind String
  expectedRevision Int
  reason String?
  result Json
  createdAt DateTime @default(now())
  entries PaymentEntry[]

  @@unique([tenantId, idempotencyKey])
  @@unique([saleId, expectedRevision])
  @@index([tenantId, saleId, createdAt])
}

model PaymentEntry {
  id String @id @default(uuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  saleId String
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Restrict)
  operationId String
  operation PaymentOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)
  kind String
  amount Decimal @db.Decimal(10,2)
  method String?
  receivedAt DateTime?
  refundOfId String?
  refundOf PaymentEntry? @relation("PaymentRefund", fields: [refundOfId], references: [id], onDelete: Restrict)
  refunds PaymentEntry[] @relation("PaymentRefund")
  createdAt DateTime @default(now())

  @@index([tenantId, saleId, createdAt])
  @@index([refundOfId])
}

model SaleItem {
  nonPerformanceChargeReason String?
  priceMode String @default("legacy")
  vatRate Decimal? @db.Decimal(5,2)
  lineSubtotal Decimal? @db.Decimal(10,2)
  discountNet Decimal? @db.Decimal(10,2)
  orderDiscountShare Decimal @default(0) @db.Decimal(10,2)
  priceOverrideReason String?
  stockState String @default("legacy")
  inventoryRequirements Json?
  booking        Appointment? @relation("BookedOrderItem")
  sectorId       String        @default(dbgenerated())
  sector         Sector        @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  id        String            @id @default(uuid())
  saleId    String
  sale      Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  serviceId String?
  service   Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  collaboratorId String?
  collaborator   Collaborator? @relation(fields: [collaboratorId], references: [id], onDelete: SetNull)
  label     String
  quantity  Int
  unitPrice Decimal           @db.Decimal(10, 2)
  discount  Decimal           @default(0) @db.Decimal(10, 2)
  taxTotal  Decimal           @default(0) @db.Decimal(10, 2)
  lineTotal Decimal           @db.Decimal(10, 2)
  /// Order of the line in the account, as arranged at the till.
  position  Int               @default(0)

  @@index([productId])
  @@index([serviceId])
  @@index([collaboratorId])
  @@index([sectorId], map: "SaleItem_sector_idx")
}

model AppointmentCancellation {
  id              String      @id @default(uuid())
  appointmentId   String
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  cancelledByType String
  cancelledById   String?
  reason          String?
  policyResult    String
  refundStatus    String?
  cancelledAt     DateTime    @default(now())

  @@index([appointmentId])
}

// Saved configuration only; dispatch activation requires the central delegation contract.
model NotificationAutomationWebhook {
  id String @id @default(uuid())
  tenantId String @unique
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorUserId String
  actorSubject String
  installationId String
  appId String
  requestKey String
  url String
  endpointId String?
  secretCipher String?
  status String @default("preparing")
  lastReceivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events NotificationAutomationWebhookEvent[]
}

model NotificationAutomationWebhookEvent {
  id String @id @default(uuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  registrationId String
  registration NotificationAutomationWebhook @relation(fields: [registrationId], references: [id], onDelete: NoAction)
  installationId String
  eventId String
  kind String
  sessionId String
  bodyHash String
  occurredAt DateTime
  receivedAt DateTime @default(now())
  status String
  reason String?
  payloadCipher String?
  processedAt DateTime?
  nextAttemptAt DateTime @default(now())
  @@unique([installationId, eventId])
  @@index([status, nextAttemptAt, receivedAt])
}

model NotificationAutomationGrant {
  whatsappRuns AppointmentAutomationRun[] @relation("AutomationWhatsappGrant")
  actionRuns AppointmentAutomationRun[] @relation("AutomationActionGrant")
  staffRuns AppointmentAutomationRun[] @relation("AutomationStaffGrant")
  commands NotificationAutomationCommand[]
  id String @id @default(uuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorUserId String
  actorSubject String
  appId String
  installationId String
  channel String
  requestKey String
  requestHash String
  request Json
  sessionId String?
  grantId String?
  credentialCipher String?
  status String @default("preparing")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId, requestKey])
  @@index([tenantId, status])
}

model NotificationAutomationCommand {
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  commandId String
  grantId String
  grant NotificationAutomationGrant @relation(fields: [grantId], references: [id], onDelete: NoAction)
  inputHash String
  payloadCipher String
  sendStartedAt DateTime?
  withdrawRequestedAt DateTime?
  withdrawResolvedAt DateTime?
  withdrawOutcome String?
  receiptId String?
  lastReceipt Json?
  nextAttemptAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@id([tenantId, commandId])
  @@index([withdrawResolvedAt, nextAttemptAt])
}

model AppointmentAutomationPolicy {
  emailGrantId String?
  enabled Boolean @default(false)
  enabledAt DateTime?
  whatsappGrantId String?
  actionGrantId String?
  staffGrantId String?
  businessNumber String?
  texts Json?
  tenantId String @id
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  revision Int @default(1)
  settings Json
  updatedByUserId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppointmentAutomationRun {
  id String @id @default(uuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId String
  order Sale @relation(fields: [orderId], references: [id], onDelete: NoAction)
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: NoAction)
  anchorAppointmentId String
  policyRevision Int
  planHash String
  contactHash String
  recipientCipher String
  whatsappGrantId String
  whatsappGrant NotificationAutomationGrant @relation("AutomationWhatsappGrant", fields: [whatsappGrantId], references: [id], onDelete: NoAction)
  actionGrantId String?
  actionGrant NotificationAutomationGrant? @relation("AutomationActionGrant", fields: [actionGrantId], references: [id], onDelete: NoAction)
  staffGrantId String?
  staffGrant NotificationAutomationGrant? @relation("AutomationStaffGrant", fields: [staffGrantId], references: [id], onDelete: NoAction)
  archiveId String
  businessNumber String
  startsAt DateTime
  expiresAt DateTime
  snapshot Json
  status String @default("waiting")
  responseAction String?
  responseEventId String?
  respondedAt DateTime?
  reviewedAt DateTime?
  reviewedByUserId String?
  staffNoticeAt DateTime?
  staffNoticeReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  actions AppointmentAutomationAction[]
  deliveries AppointmentAutomationDelivery[]
  @@unique([tenantId, orderId, policyRevision, planHash, contactHash])
  @@index([tenantId, status, expiresAt])
}

model AppointmentAutomationAction {
  tokenHash String @id
  runId String
  run AppointmentAutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  kind String
  @@unique([runId, kind])
}

model AppointmentAutomationDelivery {
  historyId String @id
  history NotificationHistory @relation(fields: [historyId], references: [id], onDelete: Cascade)
  runId String?
  run AppointmentAutomationRun? @relation(fields: [runId], references: [id], onDelete: Cascade)
  noticeContext Json?
  sequence Int
  dueAt DateTime
  validUntil DateTime
  nextAttemptAt DateTime
  @@unique([runId, sequence])
  @@index([nextAttemptAt, dueAt])
}

model NotificationDomainEvent {
  id           String @id @default(uuid())
  tenantId     String
  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventKey     String
  eventType    String
  entityType   String
  entityId     String?
  actorUserId  String?
  payload      Json
  createdAt    DateTime @default(now())
  processedAt  DateTime?
  nextAttemptAt DateTime @default(now())
  attemptCount Int @default(0)
  lastError    String?
  histories    NotificationHistory[]

  @@unique([tenantId, eventKey])
  @@index([processedAt, nextAttemptAt, createdAt])
}

model NotificationHistory {
  automationDelivery AppointmentAutomationDelivery?
  domainEventId String?
  domainEvent NotificationDomainEvent? @relation(fields: [domainEventId], references: [id], onDelete: NoAction)
  dispatchKey String?
  dispatchToken String?
  dispatchLeaseUntil DateTime?
  retrySafe Boolean @default(false)
  id                  String                     @id @default(uuid())
  tenantId            String
  tenant              Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipientUserId     String?
  customerId          String?
  channel             NotificationChannel
  providerKey         String?
  recipientType       NotificationRecipientType?
  recipientEmail      String?
  recipientWebhookUrl String?
  eventType           String
  templateId          String?
  payload             Json?
  status              NotificationStatus         @default(pending)
  error               String?
  providerMessageId   String?
  attemptCount        Int                        @default(0)
  lastAttemptAt       DateTime?
  nextRetryAt         DateTime?
  metadata            Json?
  notificationInboxId String?
  createdAt           DateTime                   @default(now())
  sentAt              DateTime?

  @@unique([domainEventId, dispatchKey])
  @@index([status, nextRetryAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
}

model NotificationInbox {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipientUserId String
  recipientUser   User      @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  eventType       String
  title           String
  message         String
  payload         Json?
  entityType      String?
  entityId        String?
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  @@index([tenantId, recipientUserId, createdAt])
  @@index([tenantId, recipientUserId, readAt])
}

model NotificationPreferenceTenant {
  id                         String              @id @default(uuid())
  tenantId                   String
  tenant                     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventType                  String
  channel                    NotificationChannel
  enabled                    Boolean             @default(true)
  sendToCustomer             Boolean             @default(false)
  sendToAssignedCollaborator Boolean             @default(false)
  sendToOwners               Boolean             @default(true)
  sendToManagers             Boolean             @default(true)
  sendToReception            Boolean             @default(true)
  options                    Json?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt

  @@unique([tenantId, eventType, channel])
  @@index([tenantId, channel])
}

model NotificationPreferenceUser {
  id        String              @id @default(uuid())
  tenantId  String
  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType String
  channel   NotificationChannel
  enabled   Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([tenantId, userId, eventType, channel])
  @@index([tenantId, userId])
}

model NotificationTemplate {
  id        String              @id @default(uuid())
  tenantId  String
  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventType String
  channel   NotificationChannel
  subject   String?
  title     String?
  body      String
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([tenantId, eventType, channel])
  @@index([eventType, channel])
}

model NotificationProviderConfig {
  id          String              @id @default(uuid())
  tenantId    String
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel     NotificationChannel
  providerKey String
  enabled     Boolean             @default(true)
  config      Json?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([tenantId, channel])
  @@index([tenantId, providerKey])
}

model AuditLog {
  id            String   @id @default(uuid())
  tenantId      String?
  tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actorUserId   String?
  actorRole     String?
  action        String
  entityType    String
  entityId      String?
  before        Json?
  after         Json?
  ipAddress     String?
  userAgent     String?
  correlationId String?
  createdAt     DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, action])
  @@index([correlationId])
}

model SubscriptionPlan {
  id                      String               @id @default(uuid())
  code                    String               @unique
  name                    String
  description             String?
  price                   Decimal              @default(0) @db.Decimal(10, 2)
  currency                String               @default("EUR")
  billingInterval         BillingInterval      @default(monthly)
  maxUsers                Int?
  maxCollaborators        Int?
  maxAppointmentsPerMonth Int?
  features                Json?
  isActive                Boolean              @default(true)
  isPublic                Boolean              @default(false)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  subscriptions           TenantSubscription[]

  @@index([isActive, isPublic])
}

model TenantSubscription {
  id                 String             @id @default(uuid())
  tenantId           String
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId             String
  plan               SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  status             SubscriptionStatus @default(trialing)
  startsAt           DateTime           @default(now())
  trialEndsAt        DateTime?
  endsAt             DateTime?
  suspendedAt        DateTime?
  cancellationReason String?
  externalReference  String?
  metadata           Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([tenantId, status])
  @@index([planId, status])
}

// Additive transitional sessions; refresh history is retained to detect replay.
model LocalSession {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectSessionId String?
  connectSession   ConnectSession? @relation(fields: [connectSessionId], references: [id], onDelete: Cascade)
  technicalAccessId String? @unique
  technicalAccess   ConnectTechnicalAccess? @relation(fields: [technicalAccessId], references: [id], onDelete: Cascade)
  familyId         String
  accessHash       String   @unique
  refreshHash      String   @unique
  accessExpiresAt  DateTime
  refreshExpiresAt DateTime
  usedAt           DateTime?
  revokedAt        DateTime?
  createdAt        DateTime @default(now())

  @@index([familyId])
  @@index([userId])
}

// Provider credentials are encrypted; browsers receive only the existing opaque ALORA tokens.
model ConnectSession {
  id               String @id @default(uuid())
  userId           String
  user             User @relation(fields: [userId], references: [id], onDelete: Cascade)
  installationId   String
  accessCipher     String
  refreshCipher    String?
  sdkSessionCipher String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime @default(now())
  sessions         LocalSession[]
  flows            ConnectAuthFlow[]
  @@index([userId])
}

// State/one-use handoff hashes and an encrypted PKCE verifier; never a password.
model ConnectAuthFlow {
  id               String @id @default(uuid())
  userId           String?
  user             User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  contextCipher    String?
  installationId   String
  stateHash        String @unique
  browserHash      String
  verifierCipher   String
  expiresAt        DateTime
  usedAt           DateTime?
  handoffHash      String? @unique
  exchangedAt      DateTime?
  connectSessionId String?
  connectSession   ConnectSession? @relation(fields: [connectSessionId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  @@index([userId, expiresAt])
}

// EULab Admin access-as grant. The operator token is encrypted, never used as
// an application session and rechecked against Connect for every request.
model ConnectTechnicalAccess {
  id                  String   @id @default(uuid())
  handoffHash         String   @unique
  installationId      String
  targetUserId        String
  targetUser          User     @relation(fields: [targetUserId], references: [id], onDelete: Cascade)
  targetSubject       String
  operatorSubject     String
  operatorTokenCipher String
  handoffExpiresAt    DateTime
  expiresAt           DateTime
  exchangedAt         DateTime?
  revokedAt           DateTime?
  createdAt           DateTime @default(now())
  sessions            LocalSession[]

  @@index([targetUserId])
  @@index([expiresAt])
}

// Server-authorized SaaS binding. The browser cannot select or change it.
model ConnectTenantBinding {
  tenantId       String @id
  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId     String
  installationId String @unique
  secretCipher   String
  createdAt      DateTime @default(now())
}

// Only permits submitting a migration request, never access to business APIs.
model ConnectMigrationChallenge {
  id        String @id @default(uuid())
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
}

// Official SDK store schema 001, managed additively with the consumer migrations.
model ConnectSdkSchema {
  version Int @id
  @@map("connect_sdk_schema")
}

model ConnectSdkRecord {
  namespace String
  id String
  cipher String
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  @@id([namespace, id])
  @@index([expiresAt], map: "connect_sdk_expiry")
  @@map("connect_sdk_records")
}

// legacyKey identifies the single, repeatable mapping of previously unscoped data.
model Location {
  stockBalances StockBalance[]
  stockMovements StockMovement[]
  id           String        @id @default(uuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legacyKey    String?
  name         String
  address      String?
  isActive     Boolean       @default(true)
  isPublic     Boolean       @default(true)
  weeklyHours  Json?
  closures     Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sectors      Sector[]
  appointments Appointment[]
  sales        Sale[]

  @@unique([tenantId, legacyKey])
  @@unique([id, tenantId])
}

// An activity run at a location: hours, rooms, professionals and history live here.
model Sector {
  id            String               @id @default(uuid())
  tenantId      String
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locationId    String
  location      Location             @relation(fields: [locationId, tenantId], references: [id, tenantId], onDelete: Cascade)
  // Filled by the database from the name when omitted; the name follows the activity.
  activityId    String               @default(dbgenerated())
  activity      Activity             @relation(fields: [activityId, tenantId], references: [id, tenantId], onDelete: Restrict)
  legacyKey     String?
  name          String
  isActive      Boolean              @default(true)
  isPublic      Boolean              @default(true)
  weeklyHours   Json?
  closures      Json?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  services      Service[]
  rooms         Room[]
  appointments  Appointment[]
  saleItems     SaleItem[]
  collaborators CollaboratorSector[]
  access        UserSectorAccess[]

  @@unique([tenantId, legacyKey])
  @@unique([id, tenantId])
  @@unique([id, locationId])
  @@index([tenantId, locationId])
  @@unique([id, tenantId, locationId])
  @@unique([locationId, activityId], map: "Sector_location_activity_key")
  @@index([tenantId, activityId])
}

// What the business does (Barberia, Estetica, Rivendita…): one catalogue for the
// account, run in one or more locations through Sector.
model Activity {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Key of the built-in catalogue (barberia, estetica, rivendita…); null for custom ones.
  preset    String?
  name      String
  color     String?
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sectors   Sector[]
  services  Service[]
  products  Product[]

  @@unique([id, tenantId])
  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

model CollaboratorSector {
  collaboratorId String
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  sectorId       String
  sector         Sector       @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@id([collaboratorId, sectorId])
}

// Operational visibility only. This grants no function and never changes Connect roles.
model UserSectorAccess {
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sectorId String
  sector   Sector @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@id([userId, sectorId])
}


model CatalogPriceHistory {
  id String @id @default(uuid())
  tenantId String
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete:Restrict)
  productId String?
  product Product? @relation(fields:[productId], references:[id], onDelete:Restrict)
  serviceId String?
  service Service? @relation(fields:[serviceId], references:[id], onDelete:Restrict)
  snapshot Json
  actorUserId String?
  reason String
  source String
  createdAt DateTime @default(now())
  @@index([tenantId, productId, createdAt])
  @@index([tenantId, serviceId, createdAt])
}

model InventoryOperation {
  id String @id @default(uuid())
  tenantId String
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete:Restrict)
  idempotencyKey String
  fingerprint String
  kind String
  actorUserId String
  reason String
  result Json?
  createdAt DateTime @default(now())
  movements StockMovement[]
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, createdAt])
}

model StockBalance {
  id String @id @default(uuid())
  tenantId String
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete:Restrict)
  locationId String
  location Location @relation(fields:[locationId], references:[id], onDelete:Restrict)
  productId String
  product Product @relation(fields:[productId], references:[id], onDelete:Restrict)
  quantity Decimal @default(0) @db.Decimal(14,3)
  value Decimal @default(0) @db.Decimal(18,6)
  initialized Boolean @default(false)
  version Int @default(0)
  @@unique([locationId, productId])
  @@index([tenantId, locationId])
}

model StockMovement {
  id String @id @default(uuid())
  tenantId String
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete:Restrict)
  operationId String
  operation InventoryOperation @relation(fields:[operationId], references:[id], onDelete:Restrict)
  locationId String
  location Location @relation(fields:[locationId], references:[id], onDelete:Restrict)
  productId String
  product Product @relation(fields:[productId], references:[id], onDelete:Restrict)
  sectorId String?
  saleId String?
  saleItemId String?
  origin Json?
  kind String
  quantityDelta Decimal @db.Decimal(14,3)
  valueDelta Decimal @db.Decimal(18,6)
  quantityAfter Decimal @db.Decimal(14,3)
  valueAfter Decimal @db.Decimal(18,6)
  purchaseVatRate Decimal? @db.Decimal(5,2)
  purchaseTax Decimal? @db.Decimal(10,2)
  returnOfId String?
  returnOf StockMovement? @relation("StockReturn",fields:[returnOfId],references:[id],onDelete:Restrict)
  returns StockMovement[] @relation("StockReturn")
  createdAt DateTime @default(now())
  @@index([tenantId, locationId, createdAt])
  @@index([tenantId, saleId])
  @@index([returnOfId])
}

model OrderPriceRevision {
  id String @id @default(uuid())
  tenantId String
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Restrict)
  saleId String
  saleItemId String
  snapshot Json
  previousSnapshot Json?
  actorUserId String?
  reason String
  source String
  createdAt DateTime @default(now())
  @@index([tenantId,saleId,createdAt])
}

// Immutable command acknowledgements. A replay never creates a second account.
model OrderOperation {
  id String @id @default(uuid())
  tenantId String
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Restrict)
  saleId String
  sale Sale @relation(fields:[saleId],references:[id],onDelete:Restrict)
  actorUserId String?
  actor User? @relation(fields:[actorUserId],references:[id],onDelete:Restrict)
  idempotencyKey String
  fingerprint String
  kind String
  source String
  result Json
  createdAt DateTime @default(now())

  @@unique([tenantId,idempotencyKey])
  @@index([tenantId,saleId,createdAt])
}

// WhatsApp connections created from ALORA. Connect does not record which app
// or person opened a connection: ownership lives here. Rule: a connection is
// managed only by the account that created it.
model WhatsAppLink {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Connect WhatsApp session id (wa_sessions.id).
  sessionId String    @unique
  createdAt DateTime  @default(now())
  removedAt DateTime?
  /// Set when the disconnect was requested from ALORA: only then the
  /// connection stays reconnectable. A disconnect from the phone removes it.
  disconnectRequestedAt DateTime?
  @@index([tenantId, userId])
}

/// Attachment of a WhatsApp message, copied from Connect into ALORA once
/// so that photos, voice notes and documents stay viewable here.
model WhatsAppMedia {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Connect archive (wa_archives.id) and message (messages.id).
  archiveId String
  messageId String
  mimetype  String
  filename  String?
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
  @@unique([archiveId, messageId])
  @@index([tenantId])
}

/// What ALORA asked Connect to send: recipient and text, so «Invii» shows
/// the outcome of each message without opening Connect.
model WhatsAppSend {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId        String
  sessionId     String
  /// Connect outbox id (outbox.id).
  outboxId      String   @unique
  customerId    String?
  recipient     String
  recipientName String?
  kind          String
  preview       String?
  createdAt     DateTime @default(now())
  @@index([tenantId, userId])
}

/// «Messaggio a tutti»: sent in the background, 30 recipients per step.
model WhatsAppBroadcast {
  id               String                       @id @default(uuid())
  tenantId         String
  tenant           Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId           String
  /// Connect session of the person who launched it: its credentials send the messages.
  connectSessionId String
  /// WhatsApp session (the linked number) on Connect.
  sessionId        String
  idempotencyKey   String
  text             String?
  /// { data, filename } of the photo, when there is one.
  image            Json?
  /// running | paused | done | cancelled
  status           String                       @default("running")
  total            Int                          @default(0)
  sent             Int                          @default(0)
  failed           Int                          @default(0)
  skipped          Int                          @default(0)
  error            String?
  nextRunAt        DateTime                     @default(now())
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  finishedAt       DateTime?
  recipients       WhatsAppBroadcastRecipient[]

  @@unique([tenantId, userId, idempotencyKey])
  @@index([status, nextRunAt])
  @@index([tenantId, userId, createdAt])
}

model WhatsAppBroadcastRecipient {
  id          String            @id @default(uuid())
  broadcastId String
  broadcast   WhatsAppBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  customerId  String
  recipient   String
  name        String?
  position    Int
  /// pending | sent | failed
  state       String            @default("pending")
  attempts    Int               @default(0)
  error       String?
  outboxId    String?
  updatedAt   DateTime          @updatedAt

  @@index([broadcastId, state, position])
}

/// Display name of a WhatsApp chat (the contact's WhatsApp profile name).
model WhatsAppChat {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  archiveId String
  chatId    String
  name      String?
  updatedAt DateTime @updatedAt
  @@unique([archiveId, chatId])
  @@index([tenantId])
}
